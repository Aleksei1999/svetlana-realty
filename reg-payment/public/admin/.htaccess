Options -Indexes
<IfModule mod_headers.c>
Header always set Cache-Control "no-store, private"
Header always set X-Robots-Tag "noindex, nofollow"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "no-referrer"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
</IfModule>
